<script>
let leadType = 'people';

function setType(btn) {
  document.querySelectorAll('.ttype').forEach(b => b.classList.remove('on'));
  btn.classList.add('on');
  leadType = btn.dataset.v;
  document.getElementById('pFields').style.display = leadType === 'businesses' ? 'none' : 'grid';
  document.getElementById('bFields').style.display = leadType === 'people' ? 'none' : 'grid';
}

const avColors = [
  {bg:'rgba(124,110,255,0.15)',c:'#b89cff'},
  {bg:'rgba(62,207,142,0.12)',c:'#3ecf8e'},
  {bg:'rgba(244,161,58,0.12)',c:'#f4a13a'},
  {bg:'rgba(244,96,96,0.12)',c:'#f46060'},
  {bg:'rgba(96,180,244,0.12)',c:'#60b4f4'},
  {bg:'rgba(207,62,182,0.12)',c:'#cf3eb6'},
];

function initials(n) { return n.split(' ').map(w=>w[0]).slice(0,2).join('').toUpperCase(); }
function sClass(n) { return n>=80?'s-hi':n>=55?'s-md':'s-lo'; }

function notify(msg) {
  const el = document.createElement('div');
  el.className = 'notif'; el.textContent = msg;
  document.body.appendChild(el);
  setTimeout(()=>el.remove(), 2500);
}

async function findLeads() {
  const industry = document.getElementById('industry').value.trim();
  const location = document.getElementById('location').value.trim();
  const jobTitle = document.getElementById('jobTitle').value.trim();
  const companySize = document.getElementById('companySize').value;
  const bizType = document.getElementById('bizType').value.trim();
  const revenue = document.getElementById('revenue').value;
  const painPoint = document.getElementById('painPoint').value.trim();
  const signals = [...document.querySelectorAll('.chip.on')].map(b=>b.textContent.trim());

  const btn = document.getElementById('searchBtn');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner"></span> Finding leads…';

  const results = document.getElementById('results');
  results.innerHTML = `<div class="loading"><span class="spinner"></span>Searching for your ideal leads…</div>`;

  const prompt = `You are a B2B lead generation expert. Generate 5 realistic, highly specific fictional leads based on these criteria:

Type: ${leadType}
Industry: ${industry||'any'}
Location: ${location||'any'}
${leadType!=='businesses'?`Job title/role: ${jobTitle||'any'}`:''}
${leadType!=='people'?`Business type: ${bizType||'any'}`:''}
Company size: ${companySize||'any'}
Revenue/funding: ${revenue||'any'}
Pain point: ${painPoint||'not specified'}
Qualification signals: ${signals.length?signals.join(', '):'none specified'}

Return ONLY a valid JSON array (no markdown, no backticks) with exactly 5 objects. Each must have:
- "name": string
- "title": string (job title for people, business category for companies)
- "company": string (company name for people leads, empty string for business leads)
- "location": string (city, country)
- "industry": string
- "employees": string (e.g. "~45 employees")
- "score": integer 40–98
- "signals": array of 2–3 short strings
- "insight": string (max 18 words, why strong match)
- "email": string (realistic fictional work email)
- "linkedin": string (realistic linkedin url)`;

  try {
    const res = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: 'claude-sonnet-4-20250514',
        max_tokens: 1000,
        messages: [{ role: 'user', content: prompt }]
      })
    });
    const data = await res.json();
    const text = data.content.map(i=>i.text||'').join('');
    const leads = JSON.parse(text.replace(/```json|```/g,'').trim());

    window._leads = leads;
    const avg = Math.round(leads.reduce((s,l)=>s+l.score,0)/leads.length);
    const hi = leads.filter(l=>l.score>=80).length;

    results.innerHTML = `
      <div style="margin-top:1.25rem;">
        <div class="results-stats">
          <div class="rstat"><div class="rstat-label">Found</div><div class="rstat-val">${leads.length}</div></div>
          <div class="rstat"><div class="rstat-label">Avg fit</div><div class="rstat-val">${avg}</div></div>
          <div class="rstat"><div class="rstat-label">High-fit</div><div class="rstat-val">${hi}</div></div>
        </div>
        <div class="results-toolbar">
          <span>Results — by fit score</span>
          <button class="lbtn" onclick="copyAll()">Copy all contacts</button>
        </div>
        ${leads.sort((a,b)=>b.score-a.score).map((l,i)=>{
          const av = avColors[i%avColors.length];
          return `<div class="lead-card">
            <div class="avatar" style="background:${av.bg};color:${av.c};">${initials(l.name)}</div>
            <div style="flex:1;min-width:0;">
              <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                <span class="lead-name">${l.name}</span>
                <span class="score-badge ${sClass(l.score)}">${l.score} fit</span>
              </div>
              <div class="lead-role">${l.title}${l.company?' · '+l.company:''}</div>
              <div class="lead-meta">
                <span class="mpill">📍 ${l.location}</span>
                <span class="mpill">🏭 ${l.industry}</span>
                <span class="mpill">👥 ${l.employees}</span>
                ${l.signals.map(s=>`<span class="signal-pill">✓ ${s}</span>`).join('')}
              </div>
              <div class="lead-insight">${l.insight}</div>
              <div class="lead-actions">
                <button class="lbtn" onclick="copyContact(${i})">Copy contact</button>
                <button class="lbtn" onclick="draftEmail(${i})">✉ Draft email</button>
                <button class="lbtn" onclick="window.open('${l.linkedin}','_blank')">LinkedIn ↗</button>
              </div>
            </div>
          </div>`;
        }).join('')}
      </div>`;
  } catch(e) {
    results.innerHTML = `<div class="loading" style="color:var(--red);">Something went wrong. Please try again.</div>`;
  }

  btn.disabled = false;
  btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 3l14 9-14 9V3z"/></svg> Find leads';
}

function copyContact(i) {
  const l = window._leads[i];
  navigator.clipboard.writeText(`${l.name}\nEmail: ${l.email}\nLinkedIn: ${l.linkedin}`).then(()=>notify('Contact copied!'));
}

function copyAll() {
  if(!window._leads) return;
  const txt = window._leads.map(l=>`${l.name} | ${l.title}${l.company?' | '+l.company:''} | ${l.location} | ${l.email} | ${l.linkedin}`).join('\n');
  navigator.clipboard.writeText(txt).then(()=>notify('All contacts copied!'));
}

function draftEmail(i) {
  const l = window._leads[i];
  const subject = `Quick question for ${l.name.split(' ')[0]}`;
  const body = `Hi ${l.name.split(' ')[0]},\n\nI came across your work at ${l.company||l.name} and thought there might be a relevant connection here.\n\n[Your value proposition tailored to ${l.industry}]\n\nWould you be open to a quick 15-minute call this week?\n\nBest,\n[Your name]`;
  const mailto = `mailto:${l.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  window.open(mailto, '_blank');
}
</script>
