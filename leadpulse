<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>LeadPulse — AI Lead Finder</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet" />
<style>
:root {
  --bg: #0a0a0f;
  --bg2: #111118;
  --bg3: #18181f;
  --border: rgba(255,255,255,0.07);
  --border2: rgba(255,255,255,0.12);
  --text: #f0eff5;
  --muted: #8a8998;
  --accent: #7c6eff;
  --accent2: #b89cff;
  --accent-glow: rgba(124,110,255,0.25);
  --green: #3ecf8e;
  --green-bg: rgba(62,207,142,0.1);
  --amber: #f4a13a;
  --amber-bg: rgba(244,161,58,0.1);
  --red: #f46060;
  --radius: 12px;
  --radius-sm: 8px;
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  background: var(--bg);
  color: var(--text);
  font-family: 'DM Sans', sans-serif;
  font-size: 16px;
  line-height: 1.6;
  min-height: 100vh;
  overflow-x: hidden;
}

/* ── Nav ── */
nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 2rem;
  height: 60px;
  background: rgba(10,10,15,0.85);
  backdrop-filter: blur(16px);
  border-bottom: 0.5px solid var(--border);
}
.logo {
  font-family: 'Syne', sans-serif;
  font-weight: 800; font-size: 18px;
  color: var(--text); text-decoration: none;
  display: flex; align-items: center; gap: 8px;
}
.logo-dot { width: 8px; height: 8px; background: var(--accent); border-radius: 50%; box-shadow: 0 0 10px var(--accent); }
.nav-links { display: flex; align-items: center; gap: 1.5rem; }
.nav-links a { color: var(--muted); text-decoration: none; font-size: 14px; transition: color 0.2s; }
.nav-links a:hover { color: var(--text); }
.nav-cta {
  background: var(--accent); color: #fff;
  padding: 7px 18px; border-radius: 999px;
  font-size: 13px; font-weight: 500; text-decoration: none;
  transition: opacity 0.2s;
}
.nav-cta:hover { opacity: 0.85; color: #fff; }

/* ── Hero ── */
.hero {
  min-height: 100vh;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  text-align: center;
  padding: 6rem 2rem 4rem;
  position: relative;
  overflow: hidden;
}
.hero-bg {
  position: absolute; inset: 0; pointer-events: none;
}
.hero-bg::before {
  content: '';
  position: absolute;
  top: -30%; left: 50%; transform: translateX(-50%);
  width: 800px; height: 600px;
  background: radial-gradient(ellipse, rgba(124,110,255,0.15) 0%, transparent 70%);
  border-radius: 50%;
}
.hero-bg::after {
  content: '';
  position: absolute;
  top: 20%; left: 10%;
  width: 300px; height: 300px;
  background: radial-gradient(circle, rgba(62,207,142,0.06) 0%, transparent 70%);
}
.badge {
  display: inline-flex; align-items: center; gap: 6px;
  background: rgba(124,110,255,0.12);
  border: 0.5px solid rgba(124,110,255,0.3);
  border-radius: 999px;
  padding: 5px 14px;
  font-size: 12px; color: var(--accent2);
  font-weight: 500;
  margin-bottom: 1.5rem;
  animation: fadeUp 0.6s ease both;
}
.badge-dot { width: 6px; height: 6px; background: var(--green); border-radius: 50%; animation: pulse 2s infinite; }
@keyframes pulse { 0%,100%{opacity:1;} 50%{opacity:0.4;} }

h1 {
  font-family: 'Syne', sans-serif;
  font-size: clamp(42px, 7vw, 80px);
  font-weight: 800;
  line-height: 1.05;
  letter-spacing: -0.03em;
  max-width: 780px;
  margin-bottom: 1.25rem;
  animation: fadeUp 0.6s 0.1s ease both;
}
h1 .accent { color: var(--accent2); }
.hero-sub {
  font-size: clamp(16px, 2vw, 19px);
  color: var(--muted);
  max-width: 520px;
  font-weight: 300;
  margin-bottom: 2.5rem;
  animation: fadeUp 0.6s 0.2s ease both;
}
.hero-actions {
  display: flex; gap: 12px; flex-wrap: wrap; justify-content: center;
  animation: fadeUp 0.6s 0.3s ease both;
}
.btn-primary {
  background: var(--accent);
  color: #fff; border: none;
  padding: 13px 28px; border-radius: 999px;
  font-size: 15px; font-weight: 500;
  cursor: pointer; text-decoration: none;
  transition: all 0.2s;
  box-shadow: 0 0 30px var(--accent-glow);
  display: inline-flex; align-items: center; gap: 8px;
}
.btn-primary:hover { transform: translateY(-1px); box-shadow: 0 0 40px rgba(124,110,255,0.4); }
.btn-secondary {
  background: transparent;
  color: var(--text);
  border: 0.5px solid var(--border2);
  padding: 13px 28px; border-radius: 999px;
  font-size: 15px; font-weight: 500;
  cursor: pointer; text-decoration: none;
  transition: all 0.2s;
}
.btn-secondary:hover { background: var(--bg3); border-color: var(--border2); }

/* ── Stats bar ── */
.stats-bar {
  display: flex; justify-content: center; gap: 3rem;
  padding: 2rem;
  animation: fadeUp 0.6s 0.4s ease both;
  flex-wrap: wrap;
}
.stat { text-align: center; }
.stat-num { font-family: 'Syne', sans-serif; font-size: 28px; font-weight: 700; color: var(--text); }
.stat-label { font-size: 12px; color: var(--muted); margin-top: 2px; }

/* ── Section ── */
section { padding: 6rem 2rem; max-width: 1100px; margin: 0 auto; }
.section-label {
  font-size: 11px; font-weight: 600; letter-spacing: 0.12em;
  text-transform: uppercase; color: var(--accent);
  margin-bottom: 0.75rem;
}
.section-title {
  font-family: 'Syne', sans-serif;
  font-size: clamp(28px, 4vw, 44px);
  font-weight: 700; line-height: 1.15;
  letter-spacing: -0.02em;
  margin-bottom: 1rem;
}
.section-sub { font-size: 17px; color: var(--muted); max-width: 540px; font-weight: 300; }

/* ── App wrapper ── */
#app-section { padding: 0 2rem 6rem; max-width: 820px; margin: 0 auto; }
.app-card {
  background: var(--bg2);
  border: 0.5px solid var(--border2);
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 40px 80px rgba(0,0,0,0.5);
}
.app-topbar {
  background: var(--bg3);
  border-bottom: 0.5px solid var(--border);
  padding: 14px 20px;
  display: flex; align-items: center; gap: 8px;
}
.dot { width: 10px; height: 10px; border-radius: 50%; }
.app-title-bar { margin-left: 8px; font-size: 13px; color: var(--muted); }
.app-body { padding: 1.75rem; }

/* ── Form elements ── */
.field-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px; }
.field-grid.one { grid-template-columns: 1fr; }
.field-grid.three { grid-template-columns: 1fr 1fr 1fr; }
.field-label {
  font-size: 11px; font-weight: 600; text-transform: uppercase;
  letter-spacing: 0.08em; color: var(--muted);
  margin-bottom: 6px; display: block;
}
.field input, .field select, .field textarea {
  width: 100%;
  background: var(--bg3);
  border: 0.5px solid var(--border2);
  border-radius: var(--radius-sm);
  padding: 10px 14px;
  color: var(--text);
  font-family: 'DM Sans', sans-serif;
  font-size: 14px;
  transition: border-color 0.2s;
  outline: none;
}
.field input::placeholder, .field textarea::placeholder { color: #555565; }
.field input:focus, .field select:focus, .field textarea:focus {
  border-color: rgba(124,110,255,0.4);
  box-shadow: 0 0 0 3px rgba(124,110,255,0.08);
}
.field textarea { resize: vertical; min-height: 70px; }
.field select { appearance: none; cursor: pointer; }
.field select option { background: var(--bg3); }

/* ── Type toggle ── */
.type-toggle { display: flex; gap: 6px; margin-bottom: 16px; flex-wrap: wrap; }
.ttype {
  padding: 6px 16px; border-radius: 999px;
  border: 0.5px solid var(--border2);
  background: transparent;
  color: var(--muted); font-size: 13px; font-weight: 500;
  cursor: pointer; font-family: 'DM Sans', sans-serif;
  transition: all 0.15s;
}
.ttype:hover { color: var(--text); border-color: rgba(255,255,255,0.2); }
.ttype.on { background: rgba(124,110,255,0.15); border-color: rgba(124,110,255,0.4); color: var(--accent2); }

/* ── Signal chips ── */
.chips { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 18px; }
.chip {
  padding: 5px 13px; border-radius: 999px;
  border: 0.5px solid var(--border2);
  background: transparent;
  color: var(--muted); font-size: 12px;
  cursor: pointer; font-family: 'DM Sans', sans-serif;
  transition: all 0.15s;
}
.chip:hover { color: var(--text); }
.chip.on { background: rgba(62,207,142,0.12); border-color: rgba(62,207,142,0.3); color: var(--green); }

/* ── Search btn ── */
.search-btn {
  width: 100%; padding: 12px;
  background: var(--accent);
  border: none; border-radius: var(--radius-sm);
  color: #fff; font-size: 15px; font-weight: 500;
  font-family: 'DM Sans', sans-serif;
  cursor: pointer; transition: all 0.2s;
  display: flex; align-items: center; justify-content: center; gap: 8px;
  box-shadow: 0 0 24px var(--accent-glow);
}
.search-btn:hover:not(:disabled) { opacity: 0.9; transform: translateY(-1px); }
.search-btn:disabled { opacity: 0.45; cursor: not-allowed; transform: none; }

/* ── Results ── */
#results { margin-top: 1.5rem; }
.results-stats { display: grid; grid-template-columns: repeat(3,1fr); gap: 10px; margin-bottom: 1.25rem; }
.rstat { background: var(--bg3); border: 0.5px solid var(--border); border-radius: var(--radius-sm); padding: 12px 16px; }
.rstat-label { font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }
.rstat-val { font-family: 'Syne', sans-serif; font-size: 24px; font-weight: 700; margin-top: 2px; }

.lead-card {
  background: var(--bg3);
  border: 0.5px solid var(--border);
  border-radius: var(--radius);
  padding: 1rem 1.25rem;
  margin-bottom: 10px;
  display: flex; gap: 14px;
  transition: border-color 0.2s;
  animation: fadeUp 0.4s ease both;
}
.lead-card:hover { border-color: var(--border2); }
.avatar {
  width: 42px; height: 42px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-family: 'Syne', sans-serif;
  font-size: 13px; font-weight: 700; flex-shrink: 0;
}
.lead-name { font-weight: 600; font-size: 15px; }
.lead-role { font-size: 13px; color: var(--muted); margin-top: 1px; }
.lead-meta { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
.mpill {
  font-size: 11px; padding: 3px 10px; border-radius: 999px;
  border: 0.5px solid var(--border);
  color: var(--muted);
}
.signal-pill {
  font-size: 11px; padding: 3px 10px; border-radius: 999px;
  background: var(--green-bg);
  border: 0.5px solid rgba(62,207,142,0.25);
  color: var(--green);
}
.score-badge {
  font-size: 11px; padding: 3px 9px; border-radius: 999px;
  font-weight: 600;
}
.s-hi { background: var(--green-bg); color: var(--green); }
.s-md { background: var(--amber-bg); color: var(--amber); }
.s-lo { background: rgba(255,255,255,0.05); color: var(--muted); }
.lead-insight {
  font-size: 12px; color: #6a6a80;
  margin-top: 8px; line-height: 1.5;
  border-left: 2px solid rgba(124,110,255,0.25);
  padding-left: 10px;
}
.lead-actions { display: flex; gap: 7px; margin-top: 10px; flex-wrap: wrap; }
.lbtn {
  font-size: 11px; padding: 5px 11px; border-radius: var(--radius-sm);
  border: 0.5px solid var(--border2);
  background: transparent; color: var(--muted);
  cursor: pointer; font-family: 'DM Sans', sans-serif;
  transition: all 0.15s;
}
.lbtn:hover { background: var(--bg2); color: var(--text); }
.results-toolbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
.results-toolbar span { font-size: 12px; color: var(--muted); letter-spacing: 0.06em; text-transform: uppercase; font-weight: 500; }

/* ── Features ── */
.features { background: var(--bg2); border-top: 0.5px solid var(--border); border-bottom: 0.5px solid var(--border); padding: 6rem 2rem; }
.features-inner { max-width: 1100px; margin: 0 auto; }
.features-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px,1fr)); gap: 1px; background: var(--border); border-radius: 16px; overflow: hidden; margin-top: 3rem; }
.feature-item { background: var(--bg2); padding: 2rem; }
.feature-icon { font-size: 22px; margin-bottom: 1rem; }
.feature-title { font-family: 'Syne', sans-serif; font-size: 17px; font-weight: 600; margin-bottom: 0.5rem; }
.feature-desc { font-size: 14px; color: var(--muted); line-height: 1.6; font-weight: 300; }

/* ── How it works ── */
.how-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px,1fr)); gap: 2rem; margin-top: 3rem; }
.how-item { position: relative; }
.how-num { font-family: 'Syne', sans-serif; font-size: 48px; font-weight: 800; color: rgba(124,110,255,0.15); line-height: 1; margin-bottom: 0.75rem; }
.how-title { font-weight: 600; margin-bottom: 0.4rem; }
.how-desc { font-size: 14px; color: var(--muted); font-weight: 300; }

/* ── Footer ── */
footer {
  border-top: 0.5px solid var(--border);
  padding: 2rem;
  display: flex; align-items: center; justify-content: space-between;
  flex-wrap: wrap; gap: 1rem;
}
footer p { font-size: 13px; color: var(--muted); }

/* ── Loading ── */
.loading { text-align: center; padding: 2.5rem; color: var(--muted); font-size: 14px; }
.spinner {
  width: 20px; height: 20px;
  border: 2px solid var(--border2);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
  display: inline-block; vertical-align: middle; margin-right: 8px;
}
@keyframes spin { to { transform: rotate(360deg); } }
@keyframes fadeUp { from { opacity:0; transform: translateY(16px); } to { opacity:1; transform: translateY(0); } }

/* ── Notification ── */
.notif {
  position: fixed; bottom: 1.5rem; right: 1.5rem;
  background: var(--bg3); border: 0.5px solid var(--border2);
  border-radius: var(--radius-sm); padding: 12px 18px;
  font-size: 13px; color: var(--green);
  animation: fadeUp 0.3s ease;
  z-index: 999;
}

@media (max-width: 640px) {
  .field-grid, .field-grid.three { grid-template-columns: 1fr; }
  nav .nav-links { display: none; }
  .stats-bar { gap: 1.5rem; }
  .results-stats { grid-template-columns: 1fr 1fr; }
}
</style>
</head>
<body>

<nav>
  <a class="logo" href="#"><span class="logo-dot"></span>LeadPulse</a>
  <div class="nav-links">
    <a href="#how">How it works</a>
    <a href="#features">Features</a>
    <a href="#app">Find leads</a>
  </div>
  <a href="#app" class="nav-cta">Get started</a>
</nav>

<!-- Hero -->
<div class="hero">
  <div class="hero-bg"></div>
  <div class="badge"><span class="badge-dot"></span> AI-powered · Free to use</div>
  <h1>Find your next<br><span class="accent">perfect lead</span></h1>
  <p class="hero-sub">Describe who you're looking for. Our AI surfaces qualified people and businesses matched to your exact criteria.</p>
  <div class="hero-actions">
    <a href="#app" class="btn-primary">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      Start finding leads
    </a>
    <a href="#how" class="btn-secondary">See how it works</a>
  </div>
  <div class="stats-bar">
    <div class="stat"><div class="stat-num">50k+</div><div class="stat-label">Leads generated</div></div>
    <div class="stat"><div class="stat-num">94%</div><div class="stat-label">Match accuracy</div></div>
    <div class="stat"><div class="stat-num">12s</div><div class="stat-label">Avg. search time</div></div>
    <div class="stat"><div class="stat-num">60+</div><div class="stat-label">Industries covered</div></div>
  </div>
</div>

<!-- App -->
<div id="app" style="background: var(--bg); padding: 0 0 2rem;">
  <div id="app-section">
    <div style="text-align:center; margin-bottom: 2rem;">
      <div class="section-label">The finder</div>
      <h2 class="section-title">Describe your ideal lead</h2>
      <p class="section-sub" style="margin: 0 auto; text-align:center;">The more specific, the better. Pain points and signals dramatically improve match quality.</p>
    </div>

    <div class="app-card">
      <div class="app-topbar">
        <div class="dot" style="background:#ff5f57;"></div>
        <div class="dot" style="background:#febc2e;"></div>
        <div class="dot" style="background:#28c840;"></div>
        <div class="app-title-bar">LeadPulse — AI Lead Finder</div>
      </div>
      <div class="app-body">

        <div style="margin-bottom:16px;">
          <div class="field-label">I'm looking for</div>
          <div class="type-toggle">
            <button class="ttype on" data-v="people" onclick="setType(this)">👤 People</button>
            <button class="ttype" data-v="businesses" onclick="setType(this)">🏢 Businesses</button>
            <button class="ttype" data-v="both" onclick="setType(this)">🌐 Both</button>
          </div>
        </div>

        <div class="field-grid">
          <div class="field">
            <label class="field-label">Industry / sector</label>
            <input type="text" id="industry" placeholder="e.g. SaaS, real estate, retail…" />
          </div>
          <div class="field">
            <label class="field-label">Location</label>
            <input type="text" id="location" placeholder="e.g. Singapore, Southeast Asia…" />
          </div>
        </div>

        <div class="field-grid" id="pFields">
          <div class="field">
            <label class="field-label">Job title / role</label>
            <input type="text" id="jobTitle" placeholder="e.g. VP Sales, Founder, CTO…" />
          </div>
          <div class="field">
            <label class="field-label">Company size</label>
            <select id="companySize">
              <option value="">Any size</option>
              <option value="1-10">1–10 (solo/micro)</option>
              <option value="11-50">11–50 (small)</option>
              <option value="51-200">51–200 (mid-market)</option>
              <option value="201-1000">201–1,000 (scale-up)</option>
              <option value="1000+">1,000+ (enterprise)</option>
            </select>
          </div>
        </div>

        <div class="field-grid one" id="bFields" style="display:none;">
          <div class="field">
            <label class="field-label">Business type</label>
            <input type="text" id="bizType" placeholder="e.g. e-commerce brands, law firms…" />
          </div>
        </div>

        <div class="field-grid one">
          <div class="field">
            <label class="field-label">Revenue / funding stage</label>
            <select id="revenue">
              <option value="">Any</option>
              <option value="pre-revenue">Pre-revenue / bootstrapped</option>
              <option value="seed">Seed funded</option>
              <option value="series-a-b">Series A–B</option>
              <option value="series-c+">Series C+</option>
              <option value="profitable-smb">Profitable SMB</option>
              <option value="enterprise">Enterprise</option>
            </select>
          </div>
        </div>

        <div class="field-grid one">
          <div class="field">
            <label class="field-label">Pain point or need they have</label>
            <textarea id="painPoint" placeholder="e.g. Scaling fast and need HR software, struggling with customer retention, expanding to new markets…"></textarea>
          </div>
        </div>

        <div style="margin-bottom:18px;">
          <div class="field-label" style="margin-bottom:8px;">Qualification signals</div>
          <div class="chips">
            <button class="chip" onclick="this.classList.toggle('on')">Recently funded</button>
            <button class="chip" onclick="this.classList.toggle('on')">Hiring rapidly</button>
            <button class="chip" onclick="this.classList.toggle('on')">New leadership</button>
            <button class="chip" onclick="this.classList.toggle('on')">Expanding markets</button>
            <button class="chip" onclick="this.classList.toggle('on')">Tech stack signal</button>
            <button class="chip" onclick="this.classList.toggle('on')">Recent press mention</button>
          </div>
        </div>

        <button class="search-btn" id="searchBtn" onclick="findLeads()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 3l14 9-14 9V3z"/></svg>
          Find leads
        </button>

        <div id="results"></div>
      </div>
    </div>
  </div>
</div>

<!-- How it works -->
<section id="how">
  <div class="section-label">Process</div>
  <h2 class="section-title">From search to outreach<br>in under a minute</h2>
  <div class="how-grid">
    <div class="how-item">
      <div class="how-num">01</div>
      <div class="how-title">Describe your target</div>
      <div class="how-desc">Industry, role, company size, location, pain points — the more detail you give, the sharper the results.</div>
    </div>
    <div class="how-item">
      <div class="how-num">02</div>
      <div class="how-title">Add signal filters</div>
      <div class="how-desc">Tag intent signals like "recently funded" or "hiring rapidly" to surface leads with demonstrated buying intent.</div>
    </div>
    <div class="how-item">
      <div class="how-num">03</div>
      <div class="how-title">Review fit scores</div>
      <div class="how-desc">Each lead gets a fit score and insight explaining exactly why they match your criteria.</div>
    </div>
